# ================================================
# Phantom Library 环境变量配置示例
# ================================================
# 复制此文件为 .env 并填入真实的配置值

# -------------------- 应用配置 --------------------
APP_NAME=Phantom Library
APP_VERSION=2.7.0
DEBUG=false
ENVIRONMENT=production

# -------------------- API密钥 --------------------
# DeepSeek AI API密钥（用于Mind Hack和RAG聊天功能）
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# -------------------- RAG配置 --------------------
# 是否启用RAG（检索增强生成）功能
ENABLE_RAG=true

# ========== Pinecone云端向量数据库配置 ==========
# Pinecone API密钥（用于云端向量存储，解决本地内存溢出问题）
# 注册地址: https://www.pinecone.io/
# 免费层：100,000个向量，约等于333篇论文
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone索引名称（自动创建，建议保持默认）
PINECONE_INDEX_NAME=phantom-library

# Pinecone云服务商（免费层可选: aws, gcp, azure）
PINECONE_CLOUD=aws

# Pinecone区域（免费层可选: us-east-1, us-west-2, eu-west-1等）
# 查看可用区域: https://docs.pinecone.io/guides/indexes/understanding-indexes#regions
PINECONE_REGION=us-east-1
